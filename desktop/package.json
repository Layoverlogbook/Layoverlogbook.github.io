{
  "name": "layover-logbook",
  "productName": "Layover Logbook",
  "version": "2.1.0",
  "description": "The layover app for airline crew",
  "author": "Layover Logbook",
  "homepage": "https://layoverlogbook.com",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.layoverlogbook.desktop",
    "productName": "Layover Logbook",
    "copyright": "Layover Logbook",
    "files": ["main.js", "offline.html", "icon.png", "package.json"],
    "directories": { "output": "dist" },
    "win": {
      "icon": "icon.png",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Layover Logbook",
      "artifactName": "LayoverLogbook-Setup.${ext}"
    },
    "portable": {
      "artifactName": "LayoverLogbook-Portable.${ext}"
    }
  }
}
